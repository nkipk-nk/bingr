# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See README.md "Environment variables" for where to get each of these.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=

# Optional — the app runs fine without it. Sentry only activates in production builds.
VITE_SENTRY_DSN=
